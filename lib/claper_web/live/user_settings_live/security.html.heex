<ClaperWeb.AppHeader.header user={@current_user} title={gettext("My account")} />
<%!-- The app's page gutters, lined up with the top bar --%>
<div class="w-full px-4 pb-24 lg:px-6 xl:px-12">
  <div class="py-4">
    <ClaperWeb.Breadcrumbs.trail items={[
      ClaperWeb.Breadcrumbs.origin(@return_event),
      {gettext("My account"), ~p"/users/settings"},
      {gettext("Sessions and activity"), nil}
    ]} />
  </div>

  <div class="max-w-3xl space-y-6 pb-8">
    <div class="card">
      <div class="card-body space-y-4">
        <div>
          <h3 class="text-lg font-semibold text-base-content">
            {gettext("Where you're signed in")}
          </h3>
          <p class="text-sm text-muted">
            {gettext("Don't recognize one? Sign it out, then change your password.")}
          </p>
        </div>

        <ul id="sessions" class="space-y-2">
          <li
            :for={s <- @sessions}
            id={"session-#{s.id}"}
            class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-base-200 px-4 py-3"
          >
            <div class="min-w-0">
              <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-base-content">
                {s.browser}
                <span :if={s.current} class="badge badge-success">{gettext("This browser")}</span>
              </p>
              <p class="mt-1 text-xs text-muted">
                {gettext("Signed in %{when}", when: when_text(s.signed_in_at))}{if s.ip_address,
                  do: " · #{s.ip_address}"}
              </p>
            </div>
            <button
              :if={!s.current}
              type="button"
              phx-click="sign_out_session"
              phx-value-id={s.id}
              class="btn btn-outline btn-sm"
            >
              {gettext("Sign out")}
            </button>
          </li>
        </ul>

        <button
          :if={Enum.count(@sessions, &(!&1.current)) > 0}
          id="sign-out-others"
          type="button"
          phx-click="sign_out_others"
          data-confirm-title={gettext("Sign out everywhere else?")}
          data-confirm={gettext("Every other browser and device will need to sign in again.")}
          data-confirm-action={gettext("Sign out everywhere else")}
          class="btn btn-outline w-full"
        >
          {gettext("Sign out everywhere else")}
        </button>
      </div>
    </div>

    <div class="card">
      <div class="card-body space-y-4">
        <div>
          <h3 class="text-lg font-semibold text-base-content">{gettext("Recent activity")}</h3>
          <p class="text-sm text-muted">
            {gettext(
              "Sign-ins and changes to your account, including any an administrator made. Something you didn't do? Change your password and tell an administrator."
            )}
          </p>
        </div>

        <p :if={@activity == []} class="text-sm text-muted">{gettext("Nothing yet.")}</p>

        <ul id="activity" class="divide-y divide-line">
          <li :for={log <- @activity} class="py-3">
            <p class="text-sm text-base-content">{describe(log)}</p>
            <p class="mt-1 text-xs text-muted">
              {when_text(log.inserted_at)}{if o = origin(log), do: " · #{o}"}
            </p>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
