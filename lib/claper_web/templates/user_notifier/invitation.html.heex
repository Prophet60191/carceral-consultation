<tr>
  <td>
    <table
      width="95%"
      border="0"
      align="center"
      cellpadding="0"
      cellspacing="0"
      style={"max-width:670px;background:#{ClaperWeb.Theme.email(:card)}; border-radius:3px; text-align:center;-webkit-box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};-moz-box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};"}
    >
      <tr>
        <td style="height:40px;">&nbsp;</td>
      </tr>
      <tr>
        <td style="padding:0 35px;">
          <h1 style={"color:#{ClaperWeb.Theme.email(:text)}; font-weight:500; margin:0;font-size:28px;font-family:'Rubik',sans-serif;"}>
            {gettext("You're invited")}
          </h1>
          <span style={"display:inline-block; vertical-align:middle; margin:29px 0 26px; border-bottom:1px solid #{ClaperWeb.Theme.email(:line)}; width:100px;"}>
          </span>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin:0;"}>
            <%= if @first_name do %>
              {gettext("Hello %{first_name},", first_name: @first_name)}<br />
            <% end %>
            {gettext("You've been given an account on %{name}, as a %{role}.",
              name: @name,
              role: @role
            )}
          </p>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin-top:16px;"}>
            {gettext("Choose your password to start. The link works for 7 days.")}
          </p>
          <a
            href={@url}
            target="_blank"
            style={"background:#{ClaperWeb.Theme.email(:button)};text-decoration:none !important; font-weight:500; margin-top:28px; color:#{ClaperWeb.Theme.email(:button_text)};text-transform:uppercase; font-size:14px;padding:10px 24px;display:inline-block;border-radius:50px;"}
          >
            {gettext("Choose a password")}
          </a>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin-top:26px;"}>
            {gettext("If you weren't expecting this, you can ignore it.")}
          </p>
        </td>
      </tr>
      <tr>
        <td style="height:20px;">&nbsp;</td>
      </tr>
      <tr>
        <td style={"font-size: 0.8em; color:#{ClaperWeb.Theme.email(:muted)}"}>
          <p class="sub">
            {gettext(
              "If you’re having trouble with the button above, copy and paste the URL below into your web browser"
            )}.
          </p>
          <p class="sub">{@url}</p>
        </td>
      </tr>
      <tr>
        <td style="height:40px;">&nbsp;</td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td style="height:20px;">&nbsp;</td>
</tr>
