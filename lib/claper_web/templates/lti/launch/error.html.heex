<div>
  <div class="relative h-screen bg-stage flex justify-center items-center">
    <div class="max-w-xl text-center">
      <p class="text-4xl font-bold text-base-content flex items-center justify-center gap-x-2">
        <span>{gettext("Oops")}</span>
      </p>
      <div class="my-8">
        <p class="text-base-content font-bold">
          {gettext("You cannot perform this action")}
        </p>
        <pre class="text-base-content my-4 text-sm bg-base-200 p-2 rounded-lg"><%= @msg %></pre>
      </div>
      <button type="button" class="btn btn-primary mx-auto mt-8" data-lti-action="close-window">
        {gettext("Close")}
      </button>
    </div>
  </div>
</div>
