<tr>
  <td>
    <table
      width="95%"
      border="0"
      align="center"
      cellpadding="0"
      cellspacing="0"
      style={"max-width:670px;background:#{ClaperWeb.Theme.email(:card)}; border-radius:3px; text-align:center;-webkit-box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};-moz-box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};"}
    >
      <tr>
        <td style="height:40px;">&nbsp;</td>
      </tr>
      <tr>
        <td style="padding:0 35px;">
          <h1 style={"color:#{ClaperWeb.Theme.email(:text)}; font-weight:500; margin:0;font-size:32px;font-family:'Rubik',sans-serif;"}>
            {gettext("Confirm your sign-in")}
          </h1>
          <span style={"display:inline-block; vertical-align:middle; margin:29px 0 26px; border-bottom:1px solid #{ClaperWeb.Theme.email(:line)}; width:100px;"}>
          </span>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin:0;"}>
            {gettext(
              "Someone signed in to %{name} with %{provider} using this email address. If this was you, open the link below in the same browser to finish signing in. The link expires in 15 minutes.",
              name: Claper.Branding.name(Claper.Branding.get()),
              provider: @provider
            )}
          </p>
          <a
            href={@url}
            target="_blank"
            style={"background:#{ClaperWeb.Theme.email(:button)};text-decoration:none !important; font-weight:500; margin-top:35px; color:#{ClaperWeb.Theme.email(:button_text)};text-transform:uppercase; font-size:14px;padding:10px 24px;display:inline-block;border-radius:50px;"}
          >
            {gettext("CONFIRM SIGN-IN")}
          </a>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin-top:26px;"}>
            {gettext("If this wasn't you, ignore this email. Your account stays unchanged.")}
          </p>
        </td>
      </tr>
      <tr>
        <td style="height:20px;">&nbsp;</td>
      </tr>
      <tr>
        <td style={"font-size: 0.8em; color:#{ClaperWeb.Theme.email(:muted)}"}>
          <p class="sub">
            {gettext(
              "If you’re having trouble with the button above, copy and paste the URL below into your web browser"
            )}.
          </p>
          <p class="sub">{@url}</p>
        </td>
      </tr>
      <tr>
        <td style="height:40px;">&nbsp;</td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td style="height:20px;">&nbsp;</td>
</tr>
