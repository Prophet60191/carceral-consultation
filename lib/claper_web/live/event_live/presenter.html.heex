<style>
  body {
    background: var(--color-stage);
  }

  iframe {
    width: 100%;
    height: 100%;
  }
</style>

<div
  id="presenter"
  phx-hook="Presenter"
  data-max-page={@event.presentation_file.length || 0}
  data-hash={@event.presentation_file.hash}
  data-current-page={@state.position}
  data-embed-active={if @current_embed, do: "true", else: "false"}
>
  <!-- JOIN SCREEN -->
  <div
    id="joinScreen"
    class={"#{if @state.join_screen_visible or not @state.started, do: "opacity-100 z-40", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-stage absolute transition-opacity"}
  >
    <%!-- Sized from the smaller of the window's width and height (.join-*),
         so it fits however the window is resized (Jose, 2026-11-14) --%>
    <%!-- Before the start with interactions on the intro page: side by side,
         the join column on the left, live results on the right (docs/INTRO.md,
         decision 14) --%>
    <div class={[
      "join-screen h-full bg-base-200 text-base-content",
      (!@state.started and @intro_results != []) && "join-split"
    ]}>
      <div class="join-col">
        <ClaperWeb.Wordmark.lockup class="brand-lockup-lg join-brand" />
        <span class="join-lead font-semibold">
          {gettext("Scan to interact in real-time")}
        </span>
        <div
          phx-hook="QRCode"
          data-code={@event.code}
          data-url={url(~p"/e/#{@event.code}")}
          data-dynamic="true"
          id="qr"
          phx-update="ignore"
          class="join-qr rounded-lg flex items-center justify-center"
        >
        </div>
        <span class="join-lead font-semibold">
          {gettext("Or go to %{url} and use the code:", url: @host)}
        </span>
        <span class="join-code font-semibold">
          #{String.upcase(@event.code)}
        </span>
        <%!-- Before the start (docs/INTRO.md, decision 9): when it begins, for
           people who aren't looking at their phones --%>
        <div :if={!@state.started} id="join-start" class="join-start flex flex-col items-center">
          <span
            id="join-start-date"
            class="join-lead text-muted"
            phx-hook="LocalDate"
            data-utc={NaiveDateTime.to_iso8601(@event.started_at)}
            data-format="LLLL"
            data-capitalize="true"
          >
            {Calendar.strftime(@event.started_at, "%B %d, %Y %H:%M")}
          </span>
          <span
            id="join-start-countdown"
            class="join-lead font-semibold"
            phx-hook="StartCountdown"
            data-starts-at={
              DateTime.to_iso8601(DateTime.from_naive!(@event.started_at, "Etc/UTC"))
            }
            data-in={gettext("Starts in %{time}", time: "%{time}")}
            data-soon={gettext("Starting soon")}
          >
          </span>
        </div>
      </div>

      <section
        :if={!@state.started and @intro_results != []}
        id="join-results"
        class="join-results"
        phx-hook="IntroCarousel"
        aria-live="polite"
      >
        <div
          :for={{result, i} <- Enum.with_index(@intro_results)}
          id={"join-result-#{result.block.id}"}
          class="join-result"
          data-slide
          hidden={i != 0}
        >
          <p class="join-result-eyebrow">
            {gettext("Live results")} · {ClaperWeb.IntroLive.Components.kind_label(
              result.block.kind
            )}
          </p>
          <h2 class="join-result-title">{result.content.title}</h2>
          <%= if result.block.kind == "form" and result.block.data["show_answers"] != true do %>
            <%!-- Written answers stay private unless the form shows them (decision 15) --%>
            <p class="join-result-count">
              {ngettext("1 person has answered", "%{count} people have answered", result.count)}
            </p>
          <% else %>
            <div class="join-result-body">
              <ClaperWeb.BreakoutLive.Components.results
                piece={result.block}
                content={result.content}
                summary={result.summary}
                large
              />
            </div>
            <p class="join-result-meta">
              {ngettext("1 answer", "%{count} answers", result.count)}
            </p>
          <% end %>
        </div>
        <div :if={length(@intro_results) > 1} class="join-dots" aria-hidden="true">
          <span :for={_ <- @intro_results} class="join-dot" data-dot></span>
        </div>
      </section>
    </div>
  </div>
  <!-- POLL -->
  <%= if @current_poll do %>
    <div
      id="poll"
      class={"#{if @state.poll_visible, do: "opacity-100", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-stage/90 absolute z-30 left-1/2 top-1/2 transform -translate-y-1/2 -translate-x-1/2 p-10 transition-opacity"}
    >
      <div class="w-full md:w-1/2 mx-auto h-full">
        <p class={"#{if @iframe, do: "text-xl mb-12", else: "text-5xl mb-24"} text-base-content font-bold  text-center"}>
          {@current_poll.title}
        </p>

        <div class={"#{if @iframe, do: "space-y-5", else: "space-y-8"} flex flex-col"}>
          <%= if (length @current_poll.poll_opts) > 0 do %>
            <%= for opt <- @current_poll.poll_opts do %>
              <div class={"#{if @iframe, do: "py-1", else: "py-4"} bg-base-300 px-6 rounded-3xl flex justify-between items-center relative text-base-content"}>
                <div
                  style={"width: #{opt.percentage}%;"}
                  class="bg-base-content/20 rounded-3xl h-full absolute left-0 transition-all"
                >
                </div>
                <div class="flex space-x-3 z-10 text-left">
                  <span class={"#{if @iframe, do: "text-base", else: "text-2xl"} flex-1 font-bold pr-2"}>
                    {opt.content}
                  </span>
                </div>
                <span class={"#{if @iframe, do: "text-base", else: "text-2xl"} z-10 font-bold"}>
                  {opt.percentage}% ({opt.vote_count})
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <!-- FORM: what people wrote, without names, while "Show answers on big screen" is on -->
  <div
    :if={@current_form}
    id="form-answers"
    class={"#{if @state.poll_visible, do: "opacity-100", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-stage/90 absolute z-30 left-1/2 top-1/2 transform -translate-y-1/2 -translate-x-1/2 p-10 transition-opacity"}
  >
    <div class="w-full md:w-1/2 mx-auto h-full flex flex-col overflow-hidden">
      <p class={"#{if @iframe, do: "text-xl mb-6", else: "text-5xl mb-12"} text-base-content font-bold text-center"}>
        {@current_form.title}
      </p>
      <p class={"#{if @iframe, do: "text-sm mb-4", else: "text-2xl mb-8"} text-muted text-center"}>
        {ngettext("1 answer", "%{count} answers", @form_summary.total)}
      </p>
      <div class="min-h-0 flex-1 overflow-hidden">
        <ClaperWeb.BreakoutLive.Components.results
          piece={%{kind: "form"}}
          content={@current_form}
          summary={@form_summary}
          large={!@iframe}
        />
      </div>
    </div>
  </div>
  <!-- QUIZ -->
  <%= if @current_quiz do %>
    <.live_component
      module={ClaperWeb.EventLive.ManageableQuizComponent}
      id={"#{@current_quiz.id}-quiz"}
      quiz={@current_quiz}
      iframe={@iframe}
    />
  <% end %>
  <!-- WORD CLOUD -->
  <div
    :if={@current_word_cloud}
    id="word-cloud"
    class={"#{if @state.poll_visible, do: "opacity-100", else: "opacity-0 pointer-events-none"} h-full w-full flex flex-col justify-center bg-stage/90 absolute z-30 left-1/2 top-1/2 transform -translate-y-1/2 -translate-x-1/2 p-10 transition-opacity"}
  >
    <div class="w-full mx-auto h-full flex flex-col justify-center">
      <header class={[
        "border-b border-line text-center",
        if(@iframe, do: "mb-6 pb-4", else: "mb-10 pb-6")
      ]}>
        <h2 class={[
          "text-muted font-semibold leading-tight",
          if(@iframe, do: "text-2xl", else: "text-[clamp(2.5rem,4vw,8rem)]")
        ]}>
          {@current_word_cloud.title}
        </h2>
      </header>

      <ClaperWeb.Component.WordCloud.cloud
        id={"word-cloud-#{@current_word_cloud.id}-words"}
        words={@word_cloud_words}
        text_color="var(--color-base-content)"
        class={[
          "w-full",
          if(@iframe,
            do: "[--presenter-word-scale:1.25]",
            else:
              "[--presenter-word-scale:2] 2xl:[--presenter-word-scale:3] min-[160rem]:[--presenter-word-scale:4]"
          )
        ]}
      />
    </div>
  </div>
  <!-- MESSAGES -->
  <div
    id="slider-wrapper"
    class={"w-full min-h-screen grid #{if (@state.chat_visible && (@event.presentation_file.length || 0) > 0) || (@current_embed && (@event.presentation_file.length || 0) == 0), do: "grid-cols-[1fr_10px_1fr]", else: "grid-cols-[1fr]"} items-center justify-center relative bg-stage"}
    phx-hook="Split"
    data-type="column"
    data-gutter=".gutter-1"
  >
    <div
      :if={@state.chat_visible}
      class="px-5 transition-all duration-150 flex flex-col h-screen py-5 justify-end max-h-screen bg-stage"
      id="post-list-wrapper"
      phx-update="replace"
    >
      <%= if @state.show_only_pinned == false do %>
        <div id="post-list" phx-update="replace">
          <%= for post <- @posts do %>
            <.presenter_post post={post} iframe={@iframe} />
          <% end %>
        </div>
      <% else %>
        <div id="pinned-posts" phx-update="replace">
          <%= for post <- @pinned_posts do %>
            <.presenter_post post={post} iframe={@iframe} />
          <% end %>
        </div>
      <% end %>
    </div>
    <div
      class={"gutter-1 row-span-full cursor-col-resize col-2 text-center text-sm leading-3 text-base-content #{if (!@state.chat_visible && (@event.presentation_file.length || 0) > 0) || (!@current_embed && (@event.presentation_file.length || 0) == 0), do: "hidden"}"}
      style="writing-mode: vertical-rl"
    >
      •••
    </div>
    <!-- SLIDES -->
    <div id="slides">
      <%= if @current_embed do %>
        <!-- EMBED -->
        <div id="embed" class="max-h-screen w-full h-screen">
          <.live_component
            id="embed-component"
            module={ClaperWeb.EventLive.EmbedIframeComponent}
            provider={@current_embed.provider}
            content={@current_embed.content}
            title={@current_embed.title}
          />
        </div>
      <% end %>
      <div
        class={"#{if @current_embed, do: "hidden", else: ""} text-center"}
        id="slider"
        phx-update="ignore"
      >
        <img
          :for={src <- Presentations.get_slide_urls(@event.presentation_file)}
          src={src}
          class="max-h-screen w-auto!"
        />
      </div>
    </div>
  </div>
  <div
    :if={!@iframe}
    id="reacts"
    phx-hook="GlobalReacts"
    data-class-name="h-24"
    class="fixed right-5 bottom-5 z-30 w-24 pointer-events-none"
    phx-update="ignore"
  >
  </div>
  
<!-- ONLINE BADGE -->
  <div
    :if={!@iframe && @state.show_attendee_count}
    class="absolute z-20 bottom-5 right-5 px-4 pt-3 pb-1 rounded-md bg-stage shadow-md text-base-content flex-1"
  >
    <div class="inline-flex justify-between items-center text-base-content text-2xl">
      <ClaperWeb.Icons.online_users class="h-12 w-12 mr-2" />
      <span id="counter" phx-hook="UpdateAttendees" phx-update="ignore">
        {@attendees_nb}
      </span>
    </div>
  </div>
</div>
<!-- TRANSCRIPTION SUBTITLES (outside #presenter to avoid slider re-init on text updates) -->
<div
  id="transcription-subtitles"
  class="fixed z-50 bottom-16 left-1/2 transform -translate-x-1/2 max-w-3xl w-full px-4"
>
  <div
    :if={
      @transcription_config && @transcription_config.enabled &&
        @transcription_config.visibility in ["both", "presenter"] && @transcription_text != ""
    }
    class="bg-stage/80 rounded-lg px-6 py-3 text-center"
  >
    <p class={"#{if @iframe, do: "text-lg", else: "text-2xl"} text-base-content font-medium"}>
      {@transcription_text}
    </p>
  </div>
</div>

<%!-- Breakouts (docs/BREAKOUT.md): while one runs, the big screen shows its
     status and timer, or the group reporting back --%>
<div
  :if={@breakout_screen}
  id="breakout-screen"
  class="fixed inset-0 z-50 overflow-y-auto bg-base-100 font-display text-base-content"
>
  <div
    :if={is_nil(@breakout_screen.report)}
    class="flex min-h-full flex-col items-center justify-center gap-8 p-12 text-center"
  >
    <p class="text-2xl font-semibold uppercase tracking-wide text-muted">{gettext("Breakout")}</p>
    <h1 class="text-5xl font-extrabold leading-tight">{@breakout_screen.breakout.title}</h1>
    <p class="text-2xl text-muted">
      {ngettext("1 group", "%{count} groups", @breakout_screen.groups)} · {ngettext(
        "1 person",
        "%{count} people",
        @breakout_screen.people
      )}
    </p>
    <ClaperWeb.BreakoutLive.Components.countdown
      id="bk-screen-timer"
      ends_at={@breakout_screen.run.ends_at}
      class="rounded-2xl bg-base-200 px-10 py-6 text-7xl font-extrabold data-[state=up]:bg-warning data-[state=up]:text-warning-content"
    />
    <p class="text-xl text-muted">
      {gettext("Groups are working. Your phone shows your group.")}
    </p>
  </div>
  <div :if={@breakout_screen.report} class="mx-auto w-full max-w-5xl p-10">
    <p class="mb-6 text-xl font-semibold uppercase tracking-wide text-muted">
      {gettext("Reporting back")} · {@breakout_screen.breakout.title}
    </p>
    <div class="flex flex-col gap-4">
      <ClaperWeb.BreakoutLive.Components.group_heading
        number={@breakout_screen.report.result.group.number}
        large
      />
      <ClaperWeb.BreakoutLive.Components.group_report
        result={@breakout_screen.report.result}
        contents={@breakout_screen.report.contents}
        large
      />
    </div>
  </div>
</div>
