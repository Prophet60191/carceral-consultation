<ClaperWeb.AppHeader.header user={@current_user} title={gettext("My account")} />
<%!-- The app's page gutters, lined up with the top bar --%>
<div class="w-full px-4 pb-24 lg:px-6 xl:px-12">
  <div class="py-4">
    <ClaperWeb.Breadcrumbs.trail items={[
      ClaperWeb.Breadcrumbs.origin(@return_event),
      {gettext("My account"), ~p"/users/settings"},
      {gettext("Two-step sign-in"), nil}
    ]} />
  </div>

  <div class="max-w-2xl pb-8">
    <div class="card">
      <div class="card-body space-y-6">
        <div>
          <div class="flex items-center gap-3">
            <h3 class="text-lg font-semibold text-base-content">{gettext("Two-step sign-in")}</h3>
            <span :if={@enabled} id="two-factor-on" class="badge badge-success">
              {gettext("On")}
            </span>
            <span :if={!@enabled} id="two-factor-off" class="badge">{gettext("Off")}</span>
          </div>
          <p class="mt-1 text-sm text-muted">
            {gettext(
              "After your password, you enter a code from an app on your phone. Someone who learns your password still can't get in."
            )}
          </p>
          <p :if={@required && !@enabled} class="mt-3 text-sm font-medium text-warning">
            {gettext("Your administrator requires two-step sign-in. Set it up to continue.")}
          </p>
        </div>
        <%!-- New backup codes: shown once --%>
        <div :if={@codes} id="backup-codes" class="space-y-4">
          <div class="panel-inset space-y-2 p-4">
            <p class="font-semibold text-base-content">{gettext("Save your backup codes")}</p>
            <p class="text-sm text-muted">
              {gettext(
                "If you lose your phone, each of these codes signs you in once. Keep them somewhere safe, such as a password manager or on paper. They won't be shown again."
              )}
            </p>
          </div>
          <ul class="grid grid-cols-2 gap-2 font-mono text-base text-base-content">
            <li :for={code <- @codes} class="rounded-lg bg-base-200 px-3 py-2 text-center">
              {code}
            </li>
          </ul>
          <button type="button" phx-click="done" class="btn btn-primary w-full">
            {gettext("I've saved them")}
          </button>
        </div>
        <%!-- Setting up --%>
        <div :if={@setup && !@codes} id="two-factor-setup" class="space-y-5">
          <ol class="space-y-5 text-sm text-base-content">
            <li>
              <p class="font-semibold">{gettext("1. Get an authenticator app")}</p>
              <p class="mt-1 text-muted">
                {gettext(
                  "Any of these works: Google Authenticator, Microsoft Authenticator, 1Password, Bitwarden, or your phone's password app."
                )}
              </p>
            </li>
            <li>
              <p class="font-semibold">{gettext("2. Scan this code with it")}</p>
              <div class="mt-3 flex flex-col items-center gap-3 sm:flex-row sm:items-start">
                <div
                  id="two-factor-qr"
                  phx-hook="QRCode"
                  phx-update="ignore"
                  data-url={@setup.uri}
                  data-size="200"
                  class="shrink-0 overflow-hidden rounded-lg"
                >
                </div>
                <div class="text-muted">
                  <p>{gettext("Can't scan it? Type this key into the app instead:")}</p>
                  <p
                    id="two-factor-key"
                    class="mt-2 font-mono text-base break-all text-base-content"
                  >
                    {@setup.text}
                  </p>
                </div>
              </div>
            </li>
            <li>
              <p class="font-semibold">{gettext("3. Enter the 6-digit code the app shows")}</p>
            </li>
          </ol>

          <form id="two-factor-confirm" phx-submit="confirm" class="space-y-3">
            <input
              id="two-factor-code"
              name="code"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="10"
              required
              class="input"
              aria-label={gettext("Code")}
            />
            <p :if={@error} class="text-sm text-error">{@error}</p>
            <div class="flex gap-3">
              <button type="button" phx-click="cancel" class="btn btn-outline flex-1">
                {gettext("Cancel")}
              </button>
              <button type="submit" class="btn btn-primary flex-1">
                {gettext("Turn on")}
              </button>
            </div>
          </form>
        </div>
        <%!-- Off --%>
        <div :if={!@enabled && !@setup && !@codes}>
          <button
            id="two-factor-start"
            type="button"
            phx-click="start"
            class="btn btn-primary w-full"
          >
            {gettext("Set up two-step sign-in")}
          </button>
        </div>
        <%!-- On --%>
        <div :if={@enabled && !@codes} class="space-y-4">
          <div class="flex items-center justify-between rounded-xl bg-base-200 px-4 py-3">
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-muted">
                {gettext("Backup codes")}
              </p>
              <p id="backup-codes-left" class="mt-1 text-sm font-medium text-base-content">
                {ngettext("1 left", "%{count} left", @codes_left)}
              </p>
            </div>
            <button type="button" phx-click="new_codes" class="btn btn-link btn-sm text-primary">
              {gettext("Make new codes")}
            </button>
          </div>

          <div :if={!@required} class="rounded-xl bg-error/10 px-4 py-3">
            <p class="text-sm text-base-content">
              {gettext(
                "Turning it off makes your password the only thing protecting your account."
              )}
            </p>
            <button
              id="two-factor-disable"
              type="button"
              phx-click="disable"
              data-confirm-title={gettext("Turn off two-step sign-in?")}
              data-confirm={
                gettext("Your password will be the only thing protecting your account.")
              }
              data-confirm-action={gettext("Turn off")}
              data-confirm-variant="destructive"
              class="btn btn-error mt-3 w-full"
            >
              {gettext("Turn off two-step sign-in")}
            </button>
          </div>
          <p :if={@required} class="text-sm text-muted">
            {gettext(
              "Your administrator requires two-step sign-in for everyone, so it can't be turned off."
            )}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
