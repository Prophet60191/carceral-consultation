<%= if @started || @is_leader do %>
  <% focus_content? =
    not is_nil(@current_slide_url) ||
      match?(%Claper.Polls.Poll{}, @current_interaction) ||
      match?(%Claper.Forms.Form{}, @current_interaction) ||
      match?(%Claper.Quizzes.Quiz{}, @current_interaction) ||
      match?(%Claper.WordClouds.WordCloud{}, @current_interaction) ||
      match?(%Claper.Embeds.Embed{attendee_visibility: true}, @current_interaction) %>
  <% interaction_mode? =
    match?(%Claper.Polls.Poll{}, @current_interaction) ||
      match?(%Claper.Forms.Form{}, @current_interaction) ||
      match?(%Claper.Quizzes.Quiz{}, @current_interaction) ||
      match?(%Claper.WordClouds.WordCloud{}, @current_interaction) ||
      match?(%Claper.Embeds.Embed{attendee_visibility: true}, @current_interaction) %>
  <% captions_visible? =
    @transcription_config && @transcription_config.enabled &&
      @transcription_config.visibility in ["both", "attendee"] %>
  <div class="h-[100dvh] overflow-hidden bg-stage lg:bg-base-100">
    <main
      id="attendee-room"
      class={[
        "relative mx-auto grid h-[100dvh] w-full max-w-lg overflow-hidden bg-stage font-display shadow-2xl",
        focus_content? && captions_visible? &&
          "grid-rows-[auto_auto_auto_minmax(0,1fr)]",
        focus_content? != captions_visible? && "grid-rows-[auto_auto_minmax(0,1fr)]",
        !focus_content? && !captions_visible? && "grid-rows-[auto_minmax(0,1fr)]"
      ]}
    >
      <div
        id="side-menu-shadow"
        phx-click={toggle_side_menu()}
        class="fixed inset-0 z-50 hidden bg-stage/70"
      >
      </div>

      <aside
        id="side-menu"
        class="fixed inset-y-0 left-0 z-[60] hidden w-64 flex-col rounded-r-2xl bg-base-200 px-4 text-base-content shadow-2xl animate__faster"
      >
        <ClaperWeb.Wordmark.mark size={:md} class="my-3 text-base-content" />
        <span class="text-xl font-bold">{@event.name}</span>
        <a
          class="btn btn-secondary mt-5 w-full justify-start"
          href={~p"/?disconnected_from=#{@event.uuid}"}
        >
          <ClaperWeb.Icons.exit class="mr-3 h-5 w-5" />
          <span>{gettext("Leave")}</span>
        </a>
        <button
          type="button"
          id="about-event"
          class="btn btn-secondary mt-2 w-full justify-start"
          phx-click={toggle_side_menu() |> JS.push("toggle-intro")}
        >
          <ClaperWeb.IntroLive.Components.icon kind="text" class="mr-3 h-5 w-5" />
          <span>{gettext("About this event")}</span>
        </button>
        <%!-- The license notices and source code (AGPL-3.0, section 13) --%>
        <a
          id="about-app"
          href={~p"/about"}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost btn-sm mt-auto mb-4 w-full justify-start text-muted"
        >
          {gettext("About this app")}
        </a>
      </aside>

      <div
        id="connection-status"
        class="pointer-events-none absolute inset-x-4 top-16 z-50 hidden items-center justify-center rounded-full bg-warning/15 px-4 py-2 text-sm font-semibold text-warning shadow-lg"
      >
        {gettext("Reconnecting...")}
      </div>

      <div
        id="identity-menu"
        phx-click-away={JS.hide(to: "#identity-menu")}
        class="absolute bottom-16 left-2 z-40 hidden w-64 rounded-2xl border border-line bg-base-100 p-2 text-base-content shadow-2xl"
      >
        <p class="px-3 pb-2 pt-1 text-xs font-semibold uppercase tracking-wide text-muted">
          {gettext("Post as")}
        </p>
        <button
          :if={@state.anonymous_chat_enabled}
          id="setAnonymous"
          type="button"
          phx-click={JS.push("set-nickname") |> JS.hide(to: "#identity-menu")}
          phx-value-nickname=""
          phx-hook="EmptyNickname"
          data-storage-key={"nickname:#{@event.uuid}"}
          class="menu-item"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-base-300">?</span>
          <span class="font-semibold">{gettext("Anonymous")}</span>
        </button>
        <button
          :if={!@state.anonymous_chat_enabled}
          type="button"
          disabled
          class="menu-item"
          aria-disabled="true"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-base-300">?</span>
          <span class="font-semibold">{gettext("Anonymous")} ({gettext("disabled")})</span>
        </button>
        <button
          id="nicknamepicker"
          type="button"
          data-prompt={gettext("Enter your name")}
          data-invalid={gettext("Nickname must be between 2 and 20 characters")}
          data-close={JS.hide(to: "#identity-menu")}
          data-storage-key={"nickname:#{@event.uuid}"}
          phx-hook="NicknamePicker"
          class="menu-item"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-primary">
            {if @nickname in [nil, ""], do: "A", else: String.first(@nickname)}
          </span>
          <span class="min-w-0">
            <span class="block text-xs text-muted">{gettext("Nickname")}</span>
            <span class="block truncate font-semibold">
              {if @nickname in [nil, ""], do: gettext("Set your nickname"), else: @nickname}
            </span>
          </span>
        </button>
      </div>

      <header
        id="room-topbar"
        class="relative z-30 bg-stage px-4 pb-3 pt-[max(0.75rem,env(safe-area-inset-top))]"
      >
        <div class="flex items-center justify-between gap-3">
          <button type="button" phx-click={toggle_side_menu()} class="btn btn-primary">
            <ClaperWeb.Icons.menu />
            <span>#{String.upcase(@event.code)}</span>
          </button>

          <div class="ml-auto inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-base-content">
            <ClaperWeb.Icons.online_users />
            <span id="counter" phx-update="ignore" phx-hook="UpdateAttendees">
              {@attendees_nb}
            </span>
          </div>
        </div>
      </header>

      <section
        :if={focus_content?}
        id="focus-slot"
        phx-hook="AttendeeFocus"
        data-focus-key={focus_key(@current_interaction, @state.position)}
        data-collapse-key={"focus-slot:#{@event.uuid}"}
        data-interaction-mode={to_string(interaction_mode?)}
        class={[
          "relative z-10 min-h-0 overflow-hidden border-y border-line bg-stage transition-[height] duration-300",
          interaction_mode? && "h-auto max-h-[40dvh]",
          !interaction_mode? && "h-[40dvh] min-h-40 max-h-[26rem]"
        ]}
      >
        <div
          id="new-interaction-badge"
          class="badge badge-primary badge-lg pointer-events-none absolute left-1/2 top-3 z-30 hidden -translate-x-1/2 shadow-lg"
        >
          {gettext("New interaction")}
        </div>

        <%= case @current_interaction do %>
          <% %Claper.Polls.Poll{} -> %>
            <div class="max-h-[40dvh] overflow-y-auto overscroll-contain p-3">
              <.live_component
                module={ClaperWeb.EventLive.PollComponent}
                id={"#{@current_interaction.id}-poll"}
                poll={@current_interaction}
                current_user={@current_user}
                attendee_identifier={@attendee_identifier}
                event={@event}
                selected_poll_opt={@selected_poll_opt}
                current_poll_vote={@current_poll_vote}
                show_results={@current_interaction.show_results}
                focus_mode
              />
            </div>
          <% %Claper.Forms.Form{} -> %>
            <div class="max-h-[40dvh] overflow-y-auto overscroll-contain p-3">
              <.live_component
                module={ClaperWeb.EventLive.FormComponent}
                id={"#{@current_interaction.id}-form"}
                form={@current_interaction}
                current_user={@current_user}
                attendee_identifier={@attendee_identifier}
                security_audit_ip={assigns[:security_audit_ip]}
                event={@event}
                current_form_submit={@current_form_submit}
                focus_mode
              />
            </div>
          <% %Claper.Quizzes.Quiz{} -> %>
            <div class="max-h-[40dvh] overflow-y-auto overscroll-contain p-3">
              <.live_component
                module={ClaperWeb.EventLive.QuizComponent}
                id={"#{@current_interaction.id}-quiz"}
                quiz={@current_interaction}
                current_user={@current_user}
                attendee_identifier={@attendee_identifier}
                event={@event}
                selected_quiz_question_opts={@selected_quiz_question_opts}
                current_quiz_question_idx={@current_quiz_question_idx}
                current_quiz_responses={@current_quiz_responses}
                quiz_score={@quiz_score}
                focus_mode
              />
            </div>
          <% %Claper.WordClouds.WordCloud{} -> %>
            <div class="max-h-[40dvh] overflow-y-auto overscroll-contain p-3">
              <.live_component
                module={ClaperWeb.EventLive.WordCloudComponent}
                id={"#{@current_interaction.id}-word-cloud"}
                word_cloud={@current_interaction}
                entries={@word_cloud_entries}
                words={@word_cloud_words}
              />
            </div>
          <% %Claper.Embeds.Embed{attendee_visibility: true} -> %>
            <div class="max-h-[40dvh] overflow-y-auto overscroll-contain p-3">
              <.live_component
                id={"#{@current_interaction.id}-embed"}
                module={ClaperWeb.EventLive.EmbedComponent}
                embed={@current_interaction}
                focus_mode
              />
            </div>
          <% _ -> %>
            <div id="focus-media" class="relative h-full w-full bg-stage">
              <img
                src={@current_slide_url}
                alt={gettext("Current presentation slide")}
                class="h-full w-full object-contain"
              />
            </div>
        <% end %>

        <button
          :if={focus_content? && !interaction_mode?}
          type="button"
          data-focus-fullscreen
          aria-label={gettext("Open fullscreen")}
          class="btn btn-overlay btn-circle absolute right-3 top-3 z-20"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 3H3v5M16 3h5v5M8 21H3v-5m13 5h5v-5"
            />
          </svg>
        </button>

        <button
          :if={focus_content? && !interaction_mode?}
          type="button"
          data-focus-collapse
          aria-label={gettext("Hide presentation")}
          class="btn btn-overlay btn-circle absolute right-16 top-3 z-20"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 15 6-6 6 6" />
          </svg>
        </button>

        <div
          :if={focus_content? && !interaction_mode?}
          data-focus-collapsed-bar
          class="hidden h-full items-center px-4"
        >
          <button
            type="button"
            data-focus-show
            class="pressable flex min-h-11 w-full items-center justify-between text-sm font-semibold text-base-content"
          >
            <span>{gettext("Show presentation")}</span>
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
            </svg>
          </button>
        </div>
      </section>

      <section
        :if={captions_visible?}
        id="caption-panel"
        phx-hook="AttendeeCaptions"
        data-collapse-key={"caption-panel:#{@event.uuid}"}
        class="relative z-10 min-h-12 max-h-32 overflow-hidden border-b border-line bg-stage transition-[height] duration-300"
      >
        <div
          data-caption-content
          class="flex min-h-12 max-h-32 items-start gap-3 overflow-y-auto px-4 py-3 pr-16"
        >
          <span class="badge badge-outline mt-0.5">CC</span>
          <p
            data-caption-text
            class={[
              "py-0.5 text-sm font-medium leading-relaxed text-base-content",
              @transcription_text == "" && "animate-pulse italic opacity-50"
            ]}
          >
            {if @transcription_text == "",
              do: gettext("Waiting for captions"),
              else: @transcription_text}
          </p>
        </div>

        <button
          type="button"
          data-caption-collapse
          aria-label={gettext("Hide captions")}
          class="btn btn-overlay btn-circle absolute right-3 top-1/2 -translate-y-1/2"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 15 6-6 6 6" />
          </svg>
        </button>

        <div data-caption-collapsed-bar class="hidden h-full items-center px-4">
          <button
            type="button"
            data-caption-show
            class="pressable flex min-h-11 w-full items-center justify-between text-sm font-semibold text-base-content"
          >
            <span>{gettext("Show captions")}</span>
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
            </svg>
          </button>
        </div>
      </section>

      <section id="chat-panel" class="relative min-h-0 overflow-visible bg-stage">
        <div
          id="chat-feed"
          class={[
            "h-full space-y-3 overflow-y-auto overscroll-contain px-4 pt-4",
            @state.message_reaction_enabled && "pb-40",
            !@state.message_reaction_enabled && "pb-24"
          ]}
          data-room-reactions={to_string(@state.message_reaction_enabled)}
          phx-update="stream"
          phx-hook="RoomFeed"
          data-chip="#new-messages-chip"
          data-posts-nb={@post_count}
        >
          <.live_component
            :for={{id, post} <- @streams.posts}
            module={ClaperWeb.EventLive.PostComponent}
            id={id}
            post={post}
            leaders={@leaders}
            is_leader={@is_leader}
            current_user={@current_user}
            attendee_identifier={@attendee_identifier}
            event={@event}
            reaction_enabled={@state.message_reaction_enabled}
            liked_posts={@like_posts}
            loved_posts={@love_posts}
            loled_posts={@lol_posts}
          />
        </div>

        <div
          :if={@post_count == 0 && @state.chat_enabled}
          class="pointer-events-none absolute inset-0 flex items-center justify-center px-8 text-center text-sm text-muted"
        >
          {gettext("Be the first to ask a question or share a thought.")}
        </div>

        <button
          id="new-messages-chip"
          type="button"
          class="btn btn-primary btn-sm absolute bottom-20 left-1/2 z-20 hidden -translate-x-1/2"
        >
          <span data-unread-count></span> {gettext("new messages")}&nbsp;↓
        </button>

        <div
          id="reacts"
          phx-hook="GlobalReacts"
          data-class-name="h-12 w-12"
          class="pointer-events-none absolute inset-0 z-10 overflow-hidden"
          phx-update="ignore"
        >
        </div>

        <div
          :if={@state.message_reaction_enabled}
          id="room-reaction-fab"
          phx-hook="RoomReactionFab"
          class="absolute bottom-20 left-4 z-20 flex w-14 flex-col items-center gap-2"
        >
          <div
            data-reaction-picker
            role="menu"
            class="hidden flex-col-reverse gap-2 rounded-full bg-base-100/95 p-2 shadow-2xl"
          >
            <button
              type="button"
              data-reaction="heart"
              role="menuitem"
              aria-label={gettext("Heart")}
              class="btn btn-ghost btn-circle"
            >
              <img
                src="/images/icons/heart.svg"
                draggable="false"
                class="pointer-events-none h-6 w-6 select-none"
              />
            </button>
            <button
              type="button"
              data-reaction="clap"
              role="menuitem"
              aria-label={gettext("Clap")}
              class="btn btn-ghost btn-circle"
            >
              <img
                src="/images/icons/clap.svg"
                draggable="false"
                class="pointer-events-none h-6 w-6 select-none"
              />
            </button>
            <button
              type="button"
              data-reaction="hundred"
              role="menuitem"
              aria-label={gettext("Hundred")}
              class="btn btn-ghost btn-circle"
            >
              <img
                src="/images/icons/hundred.svg"
                draggable="false"
                class="pointer-events-none h-6 w-6 select-none"
              />
            </button>
            <button
              type="button"
              data-reaction="raisehand"
              role="menuitem"
              aria-label={gettext("Raise hand")}
              class="btn btn-ghost btn-circle"
            >
              <img
                src="/images/icons/raisehand.svg"
                draggable="false"
                class="pointer-events-none h-6 w-6 select-none"
              />
            </button>
          </div>
          <button
            type="button"
            data-reaction-trigger
            aria-label={gettext("Send a live reaction")}
            aria-haspopup="menu"
            aria-expanded="false"
            class="btn btn-secondary btn-circle btn-lg"
          >
            <img
              data-reaction-icon
              src="/images/icons/heart.svg"
              draggable="false"
              class="pointer-events-none h-7 w-7 select-none"
            />
          </button>
        </div>
      </section>

      <footer
        id="room-composer"
        class="absolute inset-x-0 bottom-0 z-30 bg-transparent px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2"
      >
        <%= if @state.chat_enabled do %>
          <.form
            :let={f}
            for={@post_changeset}
            id="post-form"
            class="attendee-composer flex items-center gap-1.5 rounded-2xl border border-line px-1.5 py-1 shadow-2xl"
            phx-hook="PostForm"
            data-nickname={@nickname}
            data-storage-key={"post-draft:#{@event.uuid}"}
            phx-submit="save"
          >
            <button
              id="composer-identity-button"
              type="button"
              aria-label={gettext("Choose identity")}
              phx-click={JS.toggle(to: "#identity-menu")}
              class="btn btn-secondary btn-circle btn-xs shrink-0"
            >
              {if @nickname in [nil, ""], do: "A", else: String.first(@nickname)}
            </button>

            {textarea(f, :body,
              id: "postFormTA",
              disabled: !@state.anonymous_chat_enabled && @nickname in [nil, ""],
              rows: 1,
              maxlength: 255,
              class:
                "composer-input min-h-9 max-h-16 min-w-0 flex-1 resize-none border-0 bg-transparent px-2 py-2 text-base leading-5 text-base-content outline-hidden placeholder:text-muted focus:ring-0 disabled:cursor-not-allowed disabled:opacity-50",
              placeholder:
                if(!@state.anonymous_chat_enabled && @nickname in [nil, ""],
                  do: gettext("Set your nickname to participate"),
                  else: gettext("Ask, comment...")
                )
            )}

            <button
              type="submit"
              id="submitBtn"
              disabled
              aria-label={gettext("Send message")}
              class="btn btn-ghost btn-circle btn-xs shrink-0"
            >
              <ClaperWeb.Icons.send />
            </button>
          </.form>
        <% else %>
          <div class="attendee-composer flex min-h-10 items-center rounded-2xl border border-line px-3 text-sm text-muted shadow-2xl">
            {gettext("Messages deactivated")}
          </div>
        <% end %>
      </footer>
    </main>
  </div>
<% else %>
  <%!-- Until the presenter starts the event: the intro page (docs/INTRO.md) --%>
  <ClaperWeb.IntroLive.Components.intro_screen
    id="intro"
    event={@event}
    blocks={@intro_blocks}
    contents={@intro_contents}
    answers={@intro_answers}
    interactive={true}
    banner_src={@intro_page.banner_src}
    banner_alt={@intro_page.banner_alt}
    show_brand={@intro_page.show_brand}
    countdown={@countdown}
  />
<% end %>

<%!-- "About this event": the intro page over the slides (docs/INTRO.md) --%>
<div
  :if={@started and @show_intro}
  id="about-overlay"
  class="fixed inset-0 z-[70] overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label={gettext("About this event")}
>
  <ClaperWeb.IntroLive.Components.intro_screen
    id="about"
    event={@event}
    blocks={@intro_blocks}
    contents={@intro_contents}
    answers={@intro_answers}
    interactive={false}
    banner_src={@intro_page.banner_src}
    banner_alt={@intro_page.banner_alt}
    show_brand={@intro_page.show_brand}
    close="toggle-intro"
  />
</div>

<%!-- Breakouts (docs/BREAKOUT.md): while one runs, the group's screen covers the slides --%>
<ClaperWeb.BreakoutLive.Components.outside_screen
  :if={@breakout_outside}
  breakout={@breakout_outside}
/>
<ClaperWeb.BreakoutLive.Components.phone_screen
  :if={@breakout_state}
  state={@breakout_state}
  message={@breakout_message}
  error={@breakout_error}
/>
