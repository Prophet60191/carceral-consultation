<!DOCTYPE html>
<%!-- overscroll-none: no rubber-band stretch past the top or bottom, so the pinned top bar stays put (Carceral Consultation, 2026-11-13) --%>
<html lang={Gettext.get_locale(ClaperWeb.Gettext)} class="overscroll-none">
  <head>
    <ClaperWeb.ThemeScript.script />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {csrf_meta_tag()}
    <%= if assigns[:page_title] do %>
      <.live_title suffix={" · " <> brand_name()}>{@page_title}</.live_title>
    <% else %>
      <.live_title>{brand_name()}</.live_title>
    <% end %>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="icon" type="image/png" href={brand_icon()} />
    <ClaperWeb.HomeScreen.tags />
    <link phx-track-static rel="stylesheet" href={~p"/assets/custom.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="overscroll-none">
    <div class="min-h-full">
      <!-- Main column -->
      <div class="flex flex-col">
        <%!-- The header is drawn by each page (ClaperWeb.AppHeader). --%>
        <main class="flex-1">
          {@inner_content}
        </main>
      </div>
    </div>
    <ClaperWeb.AlertDialog.dialog />
  </body>
</html>
