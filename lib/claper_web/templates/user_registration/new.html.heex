<div>
  <div class="relative min-h-screen grid bg-stage">
    <div class="flex min-h-screen flex-col md:flex-row items-stretch">
      <ClaperWeb.BrandPanel.panel />
      <div class="flex w-full items-center justify-center p-8 md:w-1/2 md:p-10 lg:p-14 xl:w-2/5">
        <div class="w-full max-w-xl">
          <div class="space-y-6">
            <div class="text-center md:text-left">
              <a href="/" class="inline-flex items-center">
                <ClaperWeb.Wordmark.mark short size={:lg} class="text-base-content" />
              </a>

              <p class="mt-8 text-sm font-semibold uppercase tracking-[0.3em] text-primary">
                {gettext("Create account")}
              </p>
              <h2 class="mt-4 text-4xl font-bold text-base-content lg:text-5xl">
                {gettext("Create your account.")}
              </h2>
              <p class="mt-4 text-base leading-7 text-muted">
                {gettext(
                  "Upload a presentation, add live interactions, and share a code with your audience."
                )}
              </p>
            </div>

            <.form :let={f} for={@changeset} action={~p"/users/register"} class="space-y-6">
              <%= if @changeset.action do %>
                <ClaperWeb.Component.Alert.error message={
                  gettext("Oops, check that all fields are filled in correctly.")
                } />
              <% end %>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <ClaperWeb.Component.Input.text
                  form={f}
                  key={:first_name}
                  labelClass="text-base-content"
                  name={gettext("First name")}
                  required="true"
                  maxlength="160"
                  autofocus="true"
                />

                <ClaperWeb.Component.Input.text
                  form={f}
                  key={:last_name}
                  labelClass="text-base-content"
                  name={gettext("Last name")}
                  required="true"
                  maxlength="160"
                />
              </div>

              <ClaperWeb.Component.Input.email
                form={f}
                key={:email}
                labelClass="text-base-content"
                name={gettext("Email")}
                placeholder={gettext("you@example.com")}
                required="true"
              />

              <div class="space-y-3">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  <ClaperWeb.Component.Input.password
                    purpose={:new}
                    form={f}
                    key={:password}
                    labelClass="text-base-content"
                    name={gettext("Password")}
                    placeholder={gettext("At least 15 characters")}
                    required="true"
                  />

                  <ClaperWeb.Component.Input.password
                    purpose={:new}
                    form={f}
                    key={:password_confirmation}
                    labelClass="text-base-content"
                    name={gettext("Confirm password")}
                    placeholder={gettext("Repeat your password")}
                    required="true"
                  />
                </div>

                <p class="text-sm text-muted">
                  {gettext(
                    "Use at least 15 characters (a short sentence works well) and enter it twice."
                  )}
                </p>
              </div>

              <div class="pt-3">
                <button type="submit" class="btn btn-primary w-full">
                  {gettext("Create account")}
                </button>
              </div>
            </.form>

            <div class="space-y-4 border-t border-line pt-6 text-center md:text-left">
              <p class="text-sm text-muted">
                {gettext("Already have an account?")}
                {" "}
                {link(gettext("Log in"),
                  to: ~p"/users/log_in",
                  class: "font-semibold text-primary transition hover:text-primary"
                )}
              </p>

              <% terms_url = Application.get_env(:claper, :terms_url) %>
              <% privacy_url = Application.get_env(:claper, :privacy_url) %>
              <%= if terms_url && privacy_url do %>
                <p class="text-xs leading-6 text-muted">
                  {gettext("By creating an account, you agree to our")}
                  {" "}
                  {link(gettext("Terms of Service"),
                    to: terms_url,
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class:
                      "text-muted underline decoration-line-strong underline-offset-2 hover:text-base-content"
                  )}
                  {" "}
                  {gettext("and")}
                  {" "}
                  {link(gettext("Privacy Policy"),
                    to: privacy_url,
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class:
                      "text-muted underline decoration-line-strong underline-offset-2 hover:text-base-content"
                  )} .
                </p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
