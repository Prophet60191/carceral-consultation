<tr>
  <td>
    <table
      width="95%"
      border="0"
      align="center"
      cellpadding="0"
      cellspacing="0"
      style={"max-width:670px;background:#{ClaperWeb.Theme.email(:card)}; border-radius:3px; text-align:center;-webkit-box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};-moz-box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};box-shadow:0 6px 18px 0 #{ClaperWeb.Theme.email(:shadow)};"}
    >
      <tr>
        <td style="height:40px;">&nbsp;</td>
      </tr>
      <tr>
        <td style="padding:0 35px;">
          <h1 style={"color:#{ClaperWeb.Theme.email(:text)}; font-weight:500; margin:0;font-size:28px;font-family:'Rubik',sans-serif;"}>
            {gettext("New sign-in to your account")}
          </h1>
          <span style={"display:inline-block; vertical-align:middle; margin:29px 0 26px; border-bottom:1px solid #{ClaperWeb.Theme.email(:line)}; width:100px;"}>
          </span>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin:0;"}>
            {gettext(
              "Your %{name} account was just signed in to from a browser it hasn't used before.",
              name: @name
            )}
          </p>
          <table
            border="0"
            align="center"
            cellpadding="6"
            cellspacing="0"
            style={"margin:24px auto 0; color:#{ClaperWeb.Theme.email(:text)}; font-size:15px; text-align:left;"}
          >
            <tr>
              <td style={"color:#{ClaperWeb.Theme.email(:muted)};"}>{gettext("When")}</td>
              <td>{@signed_in_at}</td>
            </tr>
            <tr>
              <td style={"color:#{ClaperWeb.Theme.email(:muted)};"}>{gettext("Browser")}</td>
              <td>{@browser}</td>
            </tr>
            <tr :if={@ip_address}>
              <td style={"color:#{ClaperWeb.Theme.email(:muted)};"}>{gettext("Address")}</td>
              <td>{@ip_address}</td>
            </tr>
          </table>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin-top:26px;"}>
            {gettext("If this was you, there's nothing to do.")}
          </p>
          <p style={"color:#{ClaperWeb.Theme.email(:text)}; font-size:15px;line-height:24px; margin-top:12px;"}>
            {gettext(
              "If it wasn't, someone may know your password. Reset it now, and turn on two-step sign-in so a password alone can't get them in."
            )}
          </p>
          <a
            href={@reset_url}
            target="_blank"
            style={"background:#{ClaperWeb.Theme.email(:button)};text-decoration:none !important; font-weight:500; margin-top:20px; color:#{ClaperWeb.Theme.email(:button_text)};text-transform:uppercase; font-size:14px;padding:10px 24px;display:inline-block;border-radius:50px;"}
          >
            {gettext("Reset password")}
          </a>
        </td>
      </tr>
      <tr>
        <td style="height:20px;">&nbsp;</td>
      </tr>
      <tr>
        <td style={"font-size: 0.8em; color:#{ClaperWeb.Theme.email(:muted)}"}>
          <p class="sub">{gettext("Two-step sign-in:")} {@security_url}</p>
        </td>
      </tr>
      <tr>
        <td style="height:40px;">&nbsp;</td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td style="height:20px;">&nbsp;</td>
</tr>
