<ClaperWeb.AppHeader.header user={@current_user} title={gettext("My events")}>
  <:search>
    <form phx-submit="search" phx-change="search" class="relative">
      <label class="input">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        <input
          type="text"
          name="search"
          placeholder={gettext("Search")}
          aria-label={gettext("Search")}
          phx-debounce="300"
        />
      </label>
    </form>
  </:search>
  <:phone_actions>
    <%!-- Phones: the tabs in the header, between the title and the account
         button (Jose, 2026-11-16) --%>
    <.tabs style={:segmented}>
      <:tab
        active={@active_tab == "not_expired"}
        phx-click="change-tab"
        phx-value-tab="not_expired"
      >
        {gettext("Active")}
      </:tab>
      <:tab
        active={@active_tab == "expired"}
        disabled={not @has_expired_events}
        phx-click="change-tab"
        phx-value-tab="expired"
      >
        {gettext("Done")}
      </:tab>
      <:tab
        active={@active_tab == "invited"}
        disabled={not @has_invited_events}
        phx-click="change-tab"
        phx-value-tab="invited"
      >
        {gettext("Shared")}
      </:tab>
    </.tabs>
  </:phone_actions>
  <:actions>
    <%!-- In this order: tabs, grid/list, create (Jose, 2026-11-13) --%>
    <.tabs style={:segmented}>
      <:tab
        active={@active_tab == "not_expired"}
        phx-click="change-tab"
        phx-value-tab="not_expired"
      >
        {gettext("Active")}
      </:tab>
      <:tab
        active={@active_tab == "expired"}
        disabled={not @has_expired_events}
        phx-click="change-tab"
        phx-value-tab="expired"
      >
        {gettext("Done")}
      </:tab>
      <:tab
        active={@active_tab == "invited"}
        disabled={not @has_invited_events}
        phx-click="change-tab"
        phx-value-tab="invited"
      >
        {gettext("Shared")}
      </:tab>
    </.tabs>
    <div
      id="view-mode-toggle"
      phx-hook="ViewModePreference"
      class={ClaperWeb.Component.Tabs.segmented_group_class()}
      role="group"
      aria-label={gettext("View")}
    >
      <button
        phx-click="change-view"
        phx-value-view="grid"
        aria-label={gettext("Grid view")}
        aria-pressed={to_string(@view_mode == "grid")}
        class={[
          "px-3 flex items-center",
          ClaperWeb.Component.Tabs.segmented_item_class(@view_mode == "grid")
        ]}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M3 6a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3V6ZM3 15.75a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-2.25Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3v-2.25Z"
            clip-rule="evenodd"
          />
        </svg>
      </button>
      <button
        phx-click="change-view"
        phx-value-view="list"
        aria-label={gettext("List view")}
        aria-pressed={to_string(@view_mode == "list")}
        class={[
          "px-3 flex items-center",
          ClaperWeb.Component.Tabs.segmented_item_class(@view_mode == "list")
        ]}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M2.625 6.75a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0A.75.75 0 0 1 8.25 6h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75ZM2.625 12a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0ZM7.5 12a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12A.75.75 0 0 1 7.5 12Zm-4.875 5.25a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75Z"
            clip-rule="evenodd"
          />
        </svg>
      </button>
    </div>
    <.link
      patch={~p"/events/new"}
      class="btn btn-primary btn-lg"
      aria-label={gettext("Create an event")}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
          clip-rule="evenodd"
        />
      </svg>
      <span class="hidden xl:inline">{gettext("Create an event")}</span>
    </.link>
  </:actions>
</ClaperWeb.AppHeader.header>

<div class="px-4 lg:px-6 xl:px-12 pb-36 lg:pb-12">
  <!-- Filter Bar and Actions -->
  <div class="pt-4 lg:pt-6 pb-4 lg:pb-6">
    <%!-- Phones: the search box (the tabs are in the header) --%>
    <div class="lg:hidden">
      <form phx-submit="search" phx-change="search" class="relative">
        <label class="input">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <input
            type="text"
            name="search"
            placeholder={gettext("Search")}
            aria-label={gettext("Search")}
            phx-debounce="300"
          />
        </label>
      </form>
    </div>
  </div>
  
<!-- Events Grid/List -->
  <div class="relative">
    <!-- Mobile: Always list view -->
    <div role="event-list" id={"events-mobile-#{@active_tab}"} class="lg:hidden space-y-2.5">
      <% current_time = NaiveDateTime.utc_now() %>
      <%= for event <- @events do %>
        <.live_component
          module={ClaperWeb.EventLive.EventCardComponent}
          id={"event-mobile-#{@active_tab}-#{event.id}"}
          event={event}
          current_time={current_time}
          is_leader={@active_tab == "invited"}
          view_mode="mobile"
        />
      <% end %>
    </div>
    
<!-- Desktop: Grid or List based on view_mode -->
    <%= if @view_mode == "grid" do %>
      <!-- Grid View -->
      <div
        id="events"
        phx-update="replace"
        class="hidden lg:grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"
      >
        <% current_time = NaiveDateTime.utc_now() %>
        <%= for event <- @events do %>
          <.live_component
            module={ClaperWeb.EventLive.EventCardComponent}
            id={"event-#{event.id}"}
            event={event}
            current_time={current_time}
            is_leader={@active_tab == "invited"}
            view_mode={@view_mode}
          />
        <% end %>
      </div>
    <% else %>
      <!-- List View -->
      <div role="event-list" id="events" phx-update="replace" class="hidden lg:block space-y-4">
        <% current_time = NaiveDateTime.utc_now() %>
        <%= for event <- @events do %>
          <.live_component
            module={ClaperWeb.EventLive.EventCardComponent}
            id={"event-#{event.id}"}
            event={event}
            current_time={current_time}
            is_leader={@active_tab == "invited"}
            view_mode={@view_mode}
          />
        <% end %>
      </div>
    <% end %>
    
<!-- Load More Button -->
    <%= if @page < @total_pages do %>
      <div class="flex justify-center my-8">
        <button phx-click="load-more" class="btn btn-soft btn-primary">
          {gettext("Load more")}
        </button>
      </div>
    <% end %>
    
<!-- Empty State -->
    <%= if Enum.count(@events) == 0 do %>
      <div class="w-full py-16 text-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-16 w-16 mx-auto text-muted mb-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          />
        </svg>
        <p class="text-xl text-muted">{gettext("Create your first event")}</p>
        <.link patch={~p"/events/new"} class="btn btn-primary mt-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
              clip-rule="evenodd"
            />
          </svg>
          <span>{gettext("Create an event")}</span>
        </.link>
      </div>
    <% end %>
  </div>
  
<!-- Mobile Fixed Bottom Action Buttons -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-gradient-to-t from-base-200 from-70% via-base-200 via-85% to-transparent px-4 pt-12 pb-6 z-20">
    <div class="flex flex-col gap-2.5">
      <.link patch={~p"/events/new"} class="btn btn-primary w-full">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
            clip-rule="evenodd"
          />
        </svg>
        <span>{gettext("Create an event")}</span>
      </.link>
    </div>
  </div>
</div>

<!-- Drawer Overlay -->
<div
  id="drawer-overlay"
  class={"fixed inset-0 bg-stage/50 z-40 transition-opacity duration-300 #{if @live_action in [:new, :edit], do: "opacity-100", else: "opacity-0 pointer-events-none"}"}
  phx-click={JS.patch(~p"/events")}
/>

<!-- Sliding Drawer Panel -->
<div
  id="drawer-panel"
  role={if @live_action in [:new, :edit], do: "dialog"}
  aria-modal={if @live_action in [:new, :edit], do: "true"}
  aria-labelledby={if @live_action in [:new, :edit], do: "event-editor-title"}
  aria-hidden={@live_action not in [:new, :edit]}
  class={"fixed top-0 right-0 h-full w-full sm:w-[520px] sm:border-l sm:border-line-strong bg-base-100 shadow-xl z-50 transform transition-transform duration-300 ease-in-out overflow-hidden #{if @live_action in [:new, :edit], do: "translate-x-0", else: "translate-x-full"}"}
  phx-window-keydown={if @live_action in [:new, :edit], do: JS.patch(~p"/events")}
  phx-key="Escape"
>
  <%= if @live_action in [:new, :edit] do %>
    <div class="flex flex-col h-full">
      <.live_component
        module={ClaperWeb.EventLive.EventFormComponent}
        id="event-create"
        event={@event}
        page_title={@page_title}
        action={@live_action}
        return_to={~p"/events"}
        current_user={@current_user}
        container={:drawer}
      />
    </div>
  <% end %>
</div>
